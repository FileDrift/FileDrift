<ui:FluentWindow x:Class="FileDrift.App.CloudPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Select a SharePoint location"
                 Width="760" Height="620"
                 MinWidth="560" MinHeight="420"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Select a SharePoint location" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="16,4,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Scope caveat. Not dismissible at the sites level: a listing presented as the
                 tenant's contents would be a false claim, and an administrator is exactly the
                 person most likely to assume it is complete. -->
            <ui:InfoBar x:Name="ScopeBar" Grid.Row="0" Severity="Informational"
                        IsClosable="False" IsOpen="False" Margin="0,0,0,8" />

            <ui:InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error"
                        IsClosable="True" IsOpen="False" Margin="0,0,0,8" />

            <!-- Navigation: where we are, how to go back, and site search. -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="UpButton" Grid.Column="0" Margin="0,0,10,0"
                           Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="Up one level"
                           Click="OnUp" IsEnabled="False" />

                <ui:TextBlock x:Name="TrailText" Grid.Column="1" VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:TextBox x:Name="SearchBox" Grid.Column="2" Width="190" Margin="10,0,6,0"
                            PlaceholderText="Filter sites by name"
                            ToolTip="Searches the tenant's site index. Leave empty to list all sites this account can see."
                            KeyDown="OnSearchKeyDown" />
                <ui:Button x:Name="SearchButton" Grid.Column="3" Content="Search"
                           Icon="{ui:SymbolIcon Search24}" Click="OnSearch" />
            </Grid>

            <!-- Listing -->
            <Border Grid.Row="3" BorderThickness="1" CornerRadius="4"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                <Grid>
                    <ListView x:Name="ItemList" BorderThickness="0" Background="Transparent"
                              SelectionChanged="OnSelectionChanged"
                              MouseDoubleClick="OnItemDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,3,2,3">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,10,0"
                                                   VerticalAlignment="Center" />
                                    <ui:TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ui:TextBlock x:Name="EmptyText" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"
                                     Width="32" Height="32"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- What pressing Select will actually write into the path box. -->
            <ui:TextBlock x:Name="SelectionText" Grid.Row="4" Margin="0,10,0,0"
                          TextWrapping="Wrap" MaxHeight="48"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button x:Name="SelectButton" Content="Select" Appearance="Primary"
                           MinWidth="96" Margin="0,0,8,0" IsEnabled="False" Click="OnSelect" />
                <ui:Button Content="Cancel" MinWidth="96" Click="OnCancel" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
